.kotlin/

# Maven build output and TestNG/Surefire reports
target/

# Extent reports and screenshots
reports/

# ExtentReports unpacks this package tree into the working directory.
# It is not source, and it shadows the real extentreports jar in the IDE.
/com/

# Generated log folders
logs/
allure-report/
allure-results/

# Mobile app binaries
# Secrets
.env
.env.*
!.env.example

